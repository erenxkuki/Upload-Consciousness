# Upload Consciousness - environment configuration
UCC_ENV=development
UCC_LOG_LEVEL=INFO

# Database (SQLite default for development; set PostgreSQL URL for production)
UCC_DATABASE_URL=sqlite+aiosqlite:///./ucc_dev.db

# Auth / signing (CHANGE IN PRODUCTION)
UCC_JWT_SECRET=change-me-in-production-use-32-plus-random-bytes
UCC_JWT_ALGORITHM=HS256
UCC_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional Redis (coordination/cache). Leave empty to disable.
UCC_REDIS_URL=

# Node identity for distributed mode (single node by default)
UCC_NODE_ID=node-local-001
UCC_NODE_ROLE=identity_authority
